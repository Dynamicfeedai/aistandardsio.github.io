{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aistandardsio/aistandardsio.github.io/pkg/aistandards/standards",
  "properties": {
    "standards": {
      "items": {
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "agent",
              "identity",
              "general"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "proposed",
              "adopted"
            ]
          },
          "specUrl": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "implementations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slug",
          "name",
          "shortName",
          "category",
          "status",
          "specUrl",
          "description"
        ]
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "standards"
  ]
}