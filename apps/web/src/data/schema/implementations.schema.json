{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aistandardsio/aistandardsio.github.io/pkg/aistandards/implementations",
  "properties": {
    "implementations": {
      "additionalProperties": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "standards": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maintainers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "official": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "levels": {
            "properties": {
              "base": {
                "type": "boolean"
              },
              "adapters": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "examples": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "description",
          "standards",
          "languages"
        ]
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "implementations"
  ]
}