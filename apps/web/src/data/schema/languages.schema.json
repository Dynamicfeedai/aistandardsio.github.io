{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aistandardsio/aistandardsio.github.io/pkg/aistandards/languages",
  "properties": {
    "languages": {
      "additionalProperties": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "color"
        ]
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "languages"
  ]
}